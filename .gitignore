# ESP-IDF build output
build/

# Generated config (sdkconfig.defaults is the committed source of truth)
sdkconfig
sdkconfig.old

# Managed components (joltwallet/littlefs) are COMMITTED, not cached: the
# Docker build must never need network access (same rationale as the committed
# generated files). dependencies.lock pins the exact version + hash.

# Local secrets (WiFi password, Rainlog PWS key) once config is added
main/config.h

# Waveshare demo archive: ~60MB, download on demand via ./fetch-demo.sh.
# Track only the placeholder so the directory exists.
ESP32-C6-LCD-1.47-Demo/*
!ESP32-C6-LCD-1.47-Demo/.keep

# Generator input caches (gen-oui.py, gen-font.py); re-downloaded on demand.
# The generated main/net/oui_table.h and main/ui/font8x13.h ARE committed.
tools/oui.csv
tools/*.bdf

# OTA release staging (make-ota.sh output). Versioned, immutable images are
# published by rsyncing this to the server, not by committing them.
dist/

# Internal working notes, deliberately not published; README.md is the
# documentation that ships. PLAN.md was removed outright (its history lives in
# the Rainlog repo); both names stay listed so neither can reappear in a commit.
AGENTS.md
PLAN.md
