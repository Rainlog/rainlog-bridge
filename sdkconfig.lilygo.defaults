# LILYGO T3 LoRa32 V1.6.1, ESP32 with 4MB flash and UART console.
# Keep networking, TLS and OTA settings aligned with sdkconfig.defaults.
CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_ESP_TLS_USING_MBEDTLS=y
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-lilygo.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Direct OOK RX uses RMT, not the upstream packet FIFO buffer.
CONFIG_SX127X_MAX_PACKET_SIZE=64
